# Earnest — copy to .env / set in your shell. Never commit a real key.

# Otari hosted gateway (Mozilla AI) — REQUIRED for any live-model run.
# Token from otari.ai (starts with otk_). All model calls go through Otari;
# there are no direct provider calls.
OTARI_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/v1

# Open-weight model ids per role (defaults in server/lib/otari.mjs).
# Confirm real ids with GET /v1/models once the key is set — catalog
# display names and API ids may differ.
# OTARI_MODEL_PLANNER=alibaba/qwen3-max
# OTARI_MODEL_AUDITOR=deepseek/deepseek-v3.2
# OTARI_MODEL_FALLBACK=meta/llama-4-maverick

# Per-run spending limit in USD; a run aborts before exceeding it.
# OTARI_RUN_BUDGET_USD=0.50

# Earnest server (existing)
# HOST=127.0.0.1
# PORT=5173
